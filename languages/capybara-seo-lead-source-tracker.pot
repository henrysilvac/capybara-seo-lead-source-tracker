#: admin/settings-page.php:8
msgid "Captures UTM parameters and click IDs, keeps them across page visits (first-touch attribution), and automatically includes them in the WhatsApp message of your floating button, your existing buttons, and/or the [capysele_button] shortcode."
msgstr ""

#: admin/settings-page.php:14
msgid "Save changes"
msgstr ""

#: admin/settings-page.php:20
msgid "Quick setup"
msgstr ""

#: admin/settings-page.php:22
msgid "Set your WhatsApp number and save (section 1)."
msgstr ""

#: admin/settings-page.php:23
msgid "Turn on the button placement(s) that match your situation, following the guide in section 2."
msgstr ""

#: admin/settings-page.php:24
msgid "Test with a URL that includes UTM parameters, for example ?utm_source=google&utm_medium=cpc&utm_campaign=test"
msgstr ""

#: admin/settings-page.php:27
msgid "Placeholder reference"
msgstr ""

#: admin/settings-page.php:45
msgid "Use {exit_page} for the complete URL where the visitor clicks. {landing_page} is a legacy alias that returns the same click-time URL and remains available for existing templates."
msgstr ""

#: admin/settings-page.php:46
msgid "Use {exit_page_title} for the title of the page where the visitor clicks (the browser tab title), read at the moment of the click. Use the title, the URL, or both; if the page has no title, its line is removed from the message."
msgstr ""

#: admin/settings-page.php:48
msgid "How the channel is detected"
msgstr ""

#: admin/settings-page.php:49
msgid "{channel} always describes the visitor's first captured visit, not the visit where they click. Rules are checked in this order:"
msgstr ""

#: admin/settings-page.php:51
msgid "Google Ads or Meta Ads: paid UTM parameters (e.g. utm_source=google&utm_medium=cpc) or a click ID (gclid, gbraid, wbraid, fbclid)."
msgstr ""

#: admin/settings-page.php:52
msgid "Organic: utm_medium=organic."
msgstr ""

#: admin/settings-page.php:53
msgid "AI platforms (ChatGPT, Claude, Gemini, Copilot, Perplexity): detected from the referrer domain when there is no click ID and utm_medium is empty or \"referral\"."
msgstr ""

#: admin/settings-page.php:54
msgid "Referral: utm_medium=referral, or a visit from another website."
msgstr ""

#: admin/settings-page.php:55
msgid "Organic: a visit from a search engine (Google, Bing, Yahoo, DuckDuckGo, Baidu, Yandex, Ecosia)."
msgstr ""

#: admin/settings-page.php:57
msgid "With no UTMs, click IDs or external referrer, no channel is assigned and the {channel} line is removed."
msgstr ""

#: admin/settings-page.php:59
msgid "How long attribution is kept"
msgstr ""

#. translators: %d: number of days the first-touch attribution is kept.
#: admin/settings-page.php:64
#, php-format
msgid "First-touch attribution is kept in this browser's local storage for %d day by default, counted from the initial capture. Later visits and campaigns don't replace the source or restart the period. Once it expires, the plugin stops using that record and deletes it the next time it runs; a new identifiable visit can then start a new attribution period."
msgid_plural "First-touch attribution is kept in this browser's local storage for %d days by default, counted from the initial capture. Later visits and campaigns don't replace the source or restart the period. Once it expires, the plugin stops using that record and deletes it the next time it runs; a new identifiable visit can then start a new attribution period."
msgstr[0] ""
msgstr[1] ""

#: admin/settings-page.php:73
msgid "Attribution is stored per browser and device; it does not identify the same visitor across devices. {captured_at} is the date of the initial capture, not of the current visit."
msgstr ""

