msgstr "Selector CSS"

#: includes/class-capysele-settings.php:62
msgid "CSS selector value"
msgstr "Valor del selector CSS"

#: includes/class-capysele-settings.php:66
msgid "3. Message & attribution data"
msgstr "3. Mensaje y datos de atribución"

#: includes/class-capysele-settings.php:69
msgid "Message template"
msgstr "Plantilla de mensaje"

#: includes/class-capysele-settings.php:73
